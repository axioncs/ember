# Maintainer: axioncs <axioncs@users.noreply.github.com>
#
# Builds the library from source rather than shipping a prebuilt .so: the audit
# library has to match the linker and libcurl/dbus it runs against.

pkgname=ember-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Steam library tooling: install and play games your account does not own"
arch=('x86_64')
url="https://github.com/axioncs/ember"
license=('AGPL-3.0-only')
depends=('curl' 'dbus' 'gcc-libs' 'lua' 'unzip')
makedepends=('git' 'gcc' 'make' 'pkgconf' 'luajit' 'curl' 'dbus')
provides=('ember')
conflicts=('ember')
install=ember-git.install
source=(
  "ember-core::git+https://github.com/axioncs/ember-core#branch=ember"
  "ember::git+https://github.com/axioncs/ember"
)
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd ember-core
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd ember-core
  make audit-libs
}

package() {
  install -Dm755 ember-core/bin/SLSsteam.so "$pkgdir/usr/lib/ember/ember-core.so"

  install -Dm644 ember/packages/cli/ember.lua "$pkgdir/usr/share/ember/ember.lua"

  install -d "$pkgdir/usr/bin"

  cat > "$pkgdir/usr/bin/ember" <<'EOF'
#!/bin/sh
exec lua /usr/share/ember/ember.lua "$@"
EOF

  # Steam has to be launched with the library attached. Plain `steam` is
  # untouched, so this is opt-in.
  cat > "$pkgdir/usr/bin/steam-ember" <<'EOF'
#!/bin/sh
exec env LD_AUDIT=/usr/lib/ember/ember-core.so steam "$@"
EOF

  chmod 755 "$pkgdir/usr/bin/ember" "$pkgdir/usr/bin/steam-ember"

  install -Dm644 ember/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ember-core/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.core"
}
