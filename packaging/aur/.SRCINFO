pkgbase = ember-git
	pkgdesc = Steam library tooling: install and play games your account does not own
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/axioncs/ember
	install = ember-git.install
	arch = x86_64
	license = AGPL-3.0-only
	makedepends = git
	makedepends = gcc
	makedepends = make
	makedepends = pkgconf
	makedepends = luajit
	makedepends = curl
	makedepends = dbus
	depends = curl
	depends = dbus
	depends = gcc-libs
	depends = lua
	depends = unzip
	provides = ember
	conflicts = ember
	source = ember-core::git+https://github.com/axioncs/ember-core#branch=ember
	source = ember::git+https://github.com/axioncs/ember
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = ember-git
