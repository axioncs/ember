post_install() {
	cat <<'EOF'
ember is installed but not active yet. Steam has to be launched with the
library attached:

  steam-ember            launch Steam with ember
  /usr/bin/ember         the command line tool

To use it from your normal Steam icon instead, edit the desktop entry's Exec
line to:

  env LD_AUDIT=/usr/lib/ember/ember-core.so steam %U

Then import a game:

  ember import ~/Downloads/1100000.zip

and check the whole stack at any time with:

  ember doctor
EOF
}

post_upgrade() {
	post_install
}
